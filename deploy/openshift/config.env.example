# Apply as ConfigMap (non-secret) + Secret (credentials). Example:

# oc create configmap maintenancehub-config --from-env-file=config.env.example
ENVIRONMENT=production
AUTH_MODE=oidc
ALLOW_LOCAL_AUTH=false
API_CORS_ORIGINS=https://maintenancehub.apps.example.com
PUBLIC_BASE_URL=https://maintenancehub.apps.example.com
SMTP_ENABLED=false
BRIDGE_ENABLED=false
SERVICENOW_ENABLED=false
SERVICENOW_USE_FIXTURE=false
SEED_DEMO_DATA=false
OIDC_MOCK=false
LDAP_MOCK=false
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=5
DELIVERY_MAX_ATTEMPTS=5

# Secrets (do NOT commit real values) — oc create secret generic maintenancehub-secrets --from-literal=...
# DATABASE_URL=postgresql+psycopg://mh:CHANGE_ME@postgres:5432/maintenancehub
# JWT_SECRET=CHANGE_ME_LONG_RANDOM
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=maintenancehub@example.com
# OIDC_ISSUER=https://login.example.com/realms/mh
# OIDC_CLIENT_ID=maintenancehub
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_REDIRECT_URI=https://maintenancehub.apps.example.com/api/v1/auth/oidc/callback
# SERVICENOW_INSTANCE_URL=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=
