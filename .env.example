# Runtime environment: development | staging | production
ENVIRONMENT=development

# Auth: local_dev | oidc | ldap
# local_dev is refused when ENVIRONMENT is staging/production unless ALLOW_LOCAL_AUTH=true
AUTH_MODE=local_dev
ALLOW_LOCAL_AUTH=false

# Database — SQLite (local) or Postgres
# DATABASE_URL=sqlite:///./data/maintenancehub.db
DATABASE_URL=sqlite:///./data/maintenancehub.db
# DATABASE_URL=postgresql+psycopg://mh:mh@localhost:5432/maintenancehub

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-me-local-dev-only
JWT_EXPIRE_MINUTES=480
PUBLIC_BASE_URL=http://localhost:8000

# SMTP (when false, notifications use log sink)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=maintenancehub@example.com
SMTP_USE_TLS=false

# Power Automate email bridge (Teams via email bridge — no Teams APIs)
BRIDGE_ENABLED=false
BRIDGE_MAILBOX=power-automate-inbox@example.com
BRIDGE_SUBJECT_TEMPLATE=[MH-ROUTE:{channel_key}] {title}

# ServiceNow (disabled by default — null adapter; no HTTP)
SERVICENOW_ENABLED=false
SERVICENOW_USE_FIXTURE=true
SERVICENOW_FIXTURE_PATH=fixtures/servicenow_changes.json
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_QUERY=active=true
SERVICENOW_CANCEL_POLICY=cancel_event

# Enterprise auth (OIDC / LDAP) — secrets via env / OpenShift Secrets
# AUTH_MODE=oidc
# OIDC_MOCK=true
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
# AUTH_MODE=ldap
# LDAP_MOCK=true
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE=
# LDAP_USER_FILTER=(uid={username})

# Worker
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=5
DELIVERY_MAX_ATTEMPTS=5
WORKER_POLL_SECONDS=2
# WORKER_ID=worker-1

# Seed demo data on startup (local_dev only)
SEED_DEMO_DATA=true

# M17 experience profile: essentials | team | enterprise
EXPERIENCE_PROFILE=enterprise
